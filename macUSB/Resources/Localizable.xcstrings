          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Підключіть USB-накопичувач до цільового комп’ютера (Mac або ПК)"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Kết nối ổ USB với máy tính đích (Mac hoặc PC)"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 将 USB 驱动器连接到目标电脑（Mac 或 PC）"
          }
        }
      }
    },
    "• Uruchom komputer i wybierz rozruch z nośnika USB w menu startowym" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Starten Sie den Computer und wählen Sie im Startmenü den Start vom USB-Laufwerk"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Start the computer and choose to boot from the USB drive in the boot menu"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Inicia el ordenador y elige arrancar desde la unidad USB en el menú de arranque"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Démarrez l’ordinateur et choisissez le démarrage depuis le support USB dans le menu de démarrage"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Avvia il computer e seleziona l’avvio dall’unità USB nel menu di avvio"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• コンピュータを起動し、起動メニューでUSBドライブからの起動を選択します"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Inicie o computador e selecione a inicialização pela unidade USB no menu de inicialização"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Запустите компьютер и выберите загрузку с USB-накопителя в меню загрузки"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Bilgisayarı başlatın ve önyükleme menüsünde USB sürücüsünden önyüklemeyi seçin"
          }
        },
        "uk" : {
          "stringUnit" : {
