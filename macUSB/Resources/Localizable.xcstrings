    "finish.eject.force.error.description" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS kann den Datenträger weiterhin nicht auswerfen. Schließen Sie Apps, die ihn möglicherweise verwenden, und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS still can’t eject the drive. Close any apps that may be using it, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS sigue sin poder expulsar la unidad. Cierra las apps que puedan estar usándola e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS ne parvient toujours pas à éjecter le disque. Fermez les apps susceptibles de l’utiliser, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS non riesce ancora a espellere l’unità. Chiudi le app che potrebbero utilizzarla e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSはまだドライブを取り出せません。ドライブを使用している可能性のあるアプリを終了して、もう一度お試しください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS nadal nie może wysunąć nośnika. Zamknij aplikacje, które mogą z niego korzystać, i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS ainda não consegue ejetar o dispositivo. Feche os apps que possam estar usando-o e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS по-прежнему не может извлечь накопитель. Закройте приложения, которые могут его использовать, и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS sürücüyü hâlâ çıkaramıyor. Sürücüyü kullanıyor olabilecek uygulamaları kapatıp tekrar deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS усе ще не може вийняти накопичувач. Закрийте програми, які можуть його використовувати, і спробуйте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS vẫn không thể tháo ổ đĩa. Hãy đóng các ứng dụng có thể đang sử dụng ổ đĩa rồi thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS 仍无法推出驱动器。请关闭可能正在使用该驱动器的 App，然后重试。"
