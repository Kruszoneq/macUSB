    "• Brak instalatora? Użyj przycisku „Pobierz”" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Kein Installer? Benutzen Sie die Schaltfläche „Herunterladen“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• No installer? Use the \"Download\" button"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• ¿Sin instalador? Utilice el botón \"Descargar\""
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Pas d'installateur ? Utilisez le bouton \"Télécharger\""
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Nessun installer? Utilizza il pulsante \"Scarica\""
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• インストーラーがありませんか? 「ダウンロード」ボタンを使用してください"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Não há instalador? Use o botão \"Baixar\""
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Нет установщика? Используйте кнопку «Скачать»"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Kurulumcu yok mu? \"İndir\" düğmesini kullanın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Немає інсталятора? Скористайтеся кнопкою «Завантажити»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Không có trình cài đặt? Sử dụng nút \"Tải xuống\""
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 没有安装程序？使用“下载”按钮"
          }
        }
      }
    },
    "• Do utworzenia instalatora potrzebny jest nośnik USB o pojemności minimum %@ GB" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Zum Erstellen des Installers ist ein USB-Laufwerk mit mindestens %@ GB erforderlich"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• A USB drive with a minimum capacity of %@ GB is required to create the installer"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Se requiere una memoria USB con una capacidad mínima de %@ GB para crear el instalador"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Une clé USB d'une capacité minimale de %@ Go est requise pour créer l'installateur"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Per creare l'installer è necessaria un'unità USB con una capacità minima di %@ GB"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• インストーラを作成するには、最低%@GBの容量を持つUSBメモリが必要です"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• É necessário um pen drive com capacidade mínima de %@ GB para criar o instalador"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Для создания установщика требуется USB-накопитель емкостью не менее %@ ГБ"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Yükleyiciyi oluşturmak için minimum %@ GB kapasiteli bir USB sürücüsüne ihtiyacınız vardır"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Для створення інсталятора потрібен USB-накопичувач мінімальним об’ємом %@ ГБ"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Để tạo bộ cài đặt, bạn cần có ổ USB có dung lượng tối thiểu %@ GB"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 创建安装程序需要至少 %@ GB 容量的 U 盘"
          }
        }
      }
    },
    "• Dozwolone formaty plików to .dmg, .iso, .cdr oraz .app" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Zulässige Dateiformate sind .dmg, .iso, .cdr und .app"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Allowed file formats are .dmg, .iso, .cdr, and .app"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Los formatos de archivo permitidos son .dmg, .iso, .cdr y .app"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Les formats de fichiers autorisés sont .dmg, .iso, .cdr et .app"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• I formati di file consentiti sono .dmg, .iso, .cdr e .app"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 許可されるファイル形式は .dmg, .iso, .cdr および .app です"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Os formatos de arquivo permitidos são .dmg, .iso, .cdr e .app"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Допустимые форматы файлов: .dmg, .iso, .cdr и .app"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• İzin verilen dosya biçimleri .dmg, .iso, .cdr ve .app'tir"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Дозволені формати файлів: .dmg, .iso, .cdr і .app"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Các định dạng tệp được phép là .dmg, .iso, .cdr và .app"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 允许的文件格式为 .dmg, .iso, .cdr 和 .app"
          }
        }
      }
    },
    "• Pliki tymczasowe zostaną automatycznie usunięte" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Temporäre Dateien werden automatisch gelöscht"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Temporary files will be automatically deleted"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Los archivos temporales se eliminarán automáticamente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Les fichiers temporaires seront automatiquement supprimés"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• I file temporanei verranno automaticamente eliminati"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 一時ファイルは自動的に削除されます"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Arquivos temporários serão excluídos automaticamente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Временные файлы будут автоматически удалены"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Geçici dosyalar otomatik olarak silinecek"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Тимчасові файли будуть видалені автоматично"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Các tập tin tạm thời sẽ tự động bị xóa"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 临时文件将被自动删除"
          }
        }
      }
    },
    "• Po uruchomieniu Linuxa postępuj zgodnie z instrukcjami instalatora systemu" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Folgen Sie nach dem Start von Linux den Anweisungen des Installationsprogramms"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• After Linux starts, follow the installer instructions"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Después de iniciar Linux, sigue las instrucciones del instalador del sistema"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Une fois Linux démarré, suivez les instructions du programme d’installation du système"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Dopo l’avvio di Linux, segui le istruzioni del programma di installazione del sistema"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Linuxが起動したら、システムインストーラの案内に従ってください"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Após iniciar o Linux, siga as instruções do instalador do sistema"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• После запуска Linux следуйте инструкциям установщика системы"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Linux başlatıldıktan sonra sistem yükleyicisinin yönergelerini izleyin"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Після запуску Linux дотримуйтеся інструкцій інсталятора системи"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Sau khi Linux khởi động, hãy làm theo hướng dẫn của trình cài đặt hệ thống"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Linux 启动后，请按照安装程序的说明进行操作"
          }
        }
      }
    },
    "• Podłącz nośnik USB do docelowego komputera Mac" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Schließen Sie das USB-Laufwerk an den Ziel-Mac an"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Connect the USB drive to the target Mac computer"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Conecte la memoria USB al Mac de destino"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Connectez la clé USB au Mac cible"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Collega l'unità USB al Mac di destinazione"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• USBメモリを対象のMacに接続します"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Conecte o pen drive ao Mac de destino"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Подключите USB-накопитель к целевому компьютеру Mac"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• USB sürücüsünü hedef Mac'e bağlayın"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Підключіть USB-накопичувач до цільового Mac"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Kết nối ổ USB với máy Mac mục tiêu"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 将 U 盘连接到目标 Mac 电脑"
          }
        }
      }
    },
    "• Podłącz nośnik USB do komputera docelowego (Mac lub PC)" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Schließen Sie das USB-Laufwerk an den Zielcomputer an (Mac oder PC)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Connect the USB drive to the target computer (Mac or PC)"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Conecta la unidad USB al equipo de destino (Mac o PC)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Connectez le support USB à l’ordinateur cible (Mac ou PC)"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Collega l’unità USB al computer di destinazione (Mac o PC)"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• USBドライブを対象のコンピュータ（MacまたはPC）に接続します"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Conecte a unidade USB ao computador de destino (Mac ou PC)"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Подключите USB-накопитель к целевому компьютеру (Mac или ПК)"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
