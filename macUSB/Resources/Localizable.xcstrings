    "analysis.windows.server.unsupported_edition.description" : {
      "comment" : "Unsupported Windows Server edition message",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die erkannte Windows-Server-Version wird nicht unterstützt. Installationsmedien für Windows Server 2008 R2 oder neuer werden unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The detected Windows Server version is not supported. Windows Server 2008 R2 or later installers are supported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versión de Windows Server detectada no es compatible. Se admiten instaladores de Windows Server 2008 R2 o posterior."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La version de Windows Server détectée n’est pas prise en charge. Les programmes d’installation de Windows Server 2008 R2 ou version ultérieure sont pris en charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La versione di Windows Server rilevata non è supportata. Sono supportati i programmi di installazione di Windows Server 2008 R2 o versioni successive."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "検出された Windows Server のバージョンはサポートされていません。Windows Server 2008 R2 以降のインストーラがサポートされています。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wykryta wersja systemu Windows Server nie jest wspierana. Obsługiwane są instalatory Windows Server 2008 R2 lub nowszych wersji."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A versão detectada do Windows Server não é compatível. Instaladores do Windows Server 2008 R2 ou posterior são compatíveis."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обнаруженная версия Windows Server не поддерживается. Поддерживаются установщики Windows Server 2008 R2 и более новых версий."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algılanan Windows Server sürümü desteklenmiyor. Windows Server 2008 R2 veya üzeri yükleyiciler desteklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виявлена версія Windows Server не підтримується. Підтримуються інсталятори Windows Server 2008 R2 або новіших версій."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phiên bản Windows Server được phát hiện không được hỗ trợ. Bộ cài Windows Server 2008 R2 trở lên được hỗ trợ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "检测到的 Windows Server 版本不受支持。支持 Windows Server 2008 R2 或更高版本的安装程序。"
          }
        }
      }
    },
