      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tool createinstallmedia im ausgewählten Installationsprogramm ist ausschließlich für Mac Computer mit Apple Chip vorgesehen. Verwende einen Mac mit Apple Chip, um ein Installationsmedium zu erstellen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The createinstallmedia tool in the selected installer is designed only for Mac computers with Apple silicon. To create installation media, use a Mac with Apple silicon."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La herramienta createinstallmedia del instalador seleccionado está diseñada únicamente para ordenadores Mac con chip de Apple. Para crear el soporte de instalación, usa un Mac con chip de Apple."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’outil createinstallmedia du programme d’installation sélectionné est conçu uniquement pour les ordinateurs Mac avec puce Apple. Pour créer un support d’installation, utilisez un Mac avec puce Apple."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo strumento createinstallmedia nel programma di installazione selezionato è progettato esclusivamente per i computer Mac con chip Apple. Per creare il supporto di installazione, usa un Mac con chip Apple."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したインストーラのcreateinstallmediaツールは、Appleシリコン搭載Mac専用です。インストールメディアを作成するには、Appleシリコン搭載Macを使用してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narzędzie createinstallmedia w wybranym instalatorze jest przeznaczone wyłącznie dla Maców z układem scalonym Apple. Aby utworzyć nośnik instalacyjny, użyj Maca z układem scalonym Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ferramenta createinstallmedia do instalador selecionado foi desenvolvida apenas para computadores Mac com chip da Apple. Para criar uma mídia de instalação, use um Mac com chip da Apple."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инструмент createinstallmedia в выбранном установщике предназначен только для компьютеров Mac с чипом Apple. Чтобы создать установочный носитель, используйте компьютер Mac с чипом Apple."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen yükleyicideki createinstallmedia aracı yalnızca Apple çipli Mac bilgisayarlar için tasarlanmıştır. Yükleme ortamı oluşturmak için Apple çipli bir Mac kullanın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Засіб createinstallmedia у вибраному інсталяторі призначено лише для комп’ютерів Mac із чипом Apple. Щоб створити інсталяційний носій, скористайтеся комп’ютером Mac із чипом Apple."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Công cụ createinstallmedia trong trình cài đặt đã chọn chỉ dành cho máy Mac có chip Apple. Để tạo phương tiện cài đặt, hãy sử dụng máy Mac có chip Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选安装器中的 createinstallmedia 工具仅适用于配备 Apple 芯片的 Mac。若要创建安装介质，请使用配备 Apple 芯片的 Mac。"
          }
        }
      }
    },
