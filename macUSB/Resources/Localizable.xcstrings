    "analysis.file.waiting_for_installer_file.description" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie eine .dmg-, .iso-, .cdr- oder .app-Datei manuell aus oder ziehen Sie sie hierher."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Select a .dmg, .iso, .cdr, or .app file manually, or drag it above."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona manualmente un archivo .dmg, .iso, .cdr o .app, o arrástralo arriba."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez manuellement un fichier .dmg, .iso, .cdr ou .app, ou glissez-le ci-dessus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seleziona manualmente un file .dmg, .iso, .cdr o .app oppure trascinalo qui sopra."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : ".dmg、.iso、.cdr、または .app ファイルを手動で選択するか、上にドラッグしてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz plik .dmg, .iso, .cdr lub .app ręcznie albo przeciągnij go powyżej."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione manualmente um arquivo .dmg, .iso, .cdr ou .app, ou arraste-o para cima."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите файл .dmg, .iso, .cdr или .app вручную либо перетащите его выше."
          }
        },
        "tr" : {
          "stringUnit" : {
