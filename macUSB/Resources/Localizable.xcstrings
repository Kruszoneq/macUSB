    "raw_linux_img.alert.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die ausgewählte .iso- oder .img-Datei wird direkt auf das USB-Laufwerk geschrieben, ohne ihren Inhalt zu analysieren. macUSB überprüft weder die Kompatibilität des Images noch, ob das erstellte Laufwerk startfähig sein wird. Möchten Sie fortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected .iso or .img file will be written directly to the USB drive without analyzing its contents. macUSB will not verify image compatibility or whether the resulting drive will be bootable. Do you want to continue?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El archivo .iso o .img seleccionado se escribirá directamente en la unidad USB sin analizar su contenido. macUSB no comprobará la compatibilidad de la imagen ni si la unidad resultante podrá arrancar. ¿Quieres continuar?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le fichier .iso ou .img sélectionné sera écrit directement sur le lecteur USB sans analyser son contenu. macUSB ne vérifiera ni la compatibilité de l’image ni si le lecteur obtenu pourra démarrer. Voulez-vous continuer ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il file .iso o .img selezionato verrà scritto direttamente sull’unità USB senza analizzarne il contenuto. macUSB non verificherà la compatibilità dell’immagine né se l’unità risultante sarà avviabile. Vuoi continuare?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択した.isoまたは.imgファイルは、内容を解析せずにUSBドライブへ直接書き込まれます。macUSBはイメージの互換性や、作成されたドライブが起動可能かどうかを確認しません。続けますか？"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrany plik .iso lub .img zostanie zapisany bezpośrednio na nośniku USB bez analizowania jego zawartości. macUSB nie sprawdzi zgodności obrazu ani tego, czy utworzony nośnik będzie można uruchomić. Czy chcesz kontynuować?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O arquivo .iso ou .img selecionado será gravado diretamente na unidade USB sem analisar seu conteúdo. O macUSB não verificará a compatibilidade da imagem nem se a unidade resultante será inicializável. Deseja continuar?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранный файл .iso или .img будет записан непосредственно на USB-накопитель без анализа его содержимого. macUSB не проверит совместимость образа и возможность загрузки с созданного накопителя. Продолжить?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen .iso veya .img dosyası, içeriği analiz edilmeden doğrudan USB sürücüsüne yazılacak. macUSB imaj uyumluluğunu veya oluşturulan sürücünün önyüklenebilir olup olmadığını doğrulamayacak. Sürdürmek istiyor musunuz?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибраний файл .iso або .img буде записано безпосередньо на USB-носій без аналізу його вмісту. macUSB не перевірятиме сумісність образу й можливість завантаження зі створеного носія. Продовжити?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tệp .iso hoặc .img đã chọn sẽ được ghi trực tiếp vào ổ USB mà không phân tích nội dung. macUSB sẽ không xác minh tính tương thích của ảnh đĩa hoặc khả năng khởi động của ổ được tạo. Bạn có muốn tiếp tục không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选 .iso 或 .img 文件将直接写入 USB 驱动器，而不会分析其内容。macUSB 不会验证镜像兼容性，也不会检查生成的驱动器能否启动。要继续吗？"
          }
        }
      }
    },
