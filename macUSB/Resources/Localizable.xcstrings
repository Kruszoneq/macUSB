    "app.termination.active.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macUSB führt gerade einen Vorgang aus, der nicht sicher unterbrochen werden kann. Warten Sie, bis der aktuelle Vorgang abgeschlossen ist, und versuchen Sie dann erneut, die App zu beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macUSB is performing an operation that can’t be safely interrupted. Wait for the current work to finish, then try quitting the app again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macUSB está realizando una operación que no se puede interrumpir de forma segura. Espera a que termine la tarea actual e intenta cerrar la app de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macUSB effectue actuellement une opération qui ne peut pas être interrompue en toute sécurité. Attendez la fin de l’opération en cours, puis essayez à nouveau de quitter l’app."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macUSB sta eseguendo un’operazione che non può essere interrotta in sicurezza. Attendi il completamento dell’operazione in corso, quindi prova di nuovo a chiudere l’app."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macUSBは現在、安全に中断できない操作を実行しています。処理が完了してから、もう一度アプリを終了してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macUSB wykonuje operację, której nie można bezpiecznie przerwać. Poczekaj na zakończenie bieżącej pracy, a następnie spróbuj ponownie zamknąć aplikację."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macUSB está executando uma operação que não pode ser interrompida com segurança. Aguarde a conclusão do trabalho atual e tente encerrar o app novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macUSB выполняет операцию, которую нельзя безопасно прервать. Дождитесь завершения текущей работы, затем снова попробуйте завершить работу приложения."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macUSB şu anda güvenli bir şekilde kesintiye uğratılamayacak bir işlem yürütüyor. Mevcut işin tamamlanmasını bekleyin, ardından uygulamadan çıkmayı yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macUSB виконує операцію, яку не можна безпечно перервати. Дочекайтеся завершення поточної роботи, а потім знову спробуйте завершити роботу програми."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macUSB đang thực hiện một tác vụ không thể dừng một cách an toàn. Hãy chờ tác vụ hiện tại hoàn tất, sau đó thử thoát ứng dụng lần nữa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macUSB 正在执行一项无法安全中断的操作。请等待当前工作完成，然后再次尝试退出 App。"
          }
        }
      }
    },
    "app.termination.active.title" : {
