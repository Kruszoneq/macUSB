        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer la capacidad de esta unidad. Compruebe la conexión USB e inténtelo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
