    "analysis.macos.architecture.unknown.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Architektur des Tools createinstallmedia konnte nicht ermittelt werden. Aus Sicherheitsgründen kann dieses Installationsprogramm nicht verwendet werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The architecture of the createinstallmedia tool couldn’t be read. For safety, this installer can’t be used."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se ha podido leer la arquitectura de la herramienta createinstallmedia. Por seguridad, no se puede usar este instalador."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’architecture de l’outil createinstallmedia n’a pas pu être lue. Par mesure de sécurité, ce programme d’installation ne peut pas être utilisé."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile leggere l’architettura dello strumento createinstallmedia. Per motivi di sicurezza, questo programma di installazione non può essere utilizzato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "createinstallmediaツールのアーキテクチャを読み取れませんでした。安全のため、このインストーラは使用できません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się odczytać architektury narzędzia createinstallmedia. Ze względów bezpieczeństwa nie można użyć tego instalatora."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível ler a arquitetura da ferramenta createinstallmedia. Por segurança, este instalador não pode ser usado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось определить архитектуру инструмента createinstallmedia. В целях безопасности этот установщик нельзя использовать."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "createinstallmedia aracının mimarisi okunamadı. Güvenlik nedeniyle bu yükleyici kullanılamaz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося визначити архітектуру засобу createinstallmedia. З міркувань безпеки цей інсталятор не можна використовувати."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể đọc kiến trúc của công cụ createinstallmedia. Vì lý do an toàn, bạn không thể sử dụng trình cài đặt này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法读取 createinstallmedia 工具的架构。出于安全考虑，无法使用此安装器。"
          }
        }
      }
    },
