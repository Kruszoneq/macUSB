    "analysis.usb.waiting_for_system_detection.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das angeschlossene USB-Laufwerk wird verfügbar, sobald die Systemerkennung abgeschlossen und die erforderlichen Medienanforderungen festgelegt sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The connected USB device will become available after system recognition is complete and the required media criteria have been determined."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El dispositivo USB conectado estará disponible cuando se complete el reconocimiento del sistema y se determinen los requisitos del medio."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le périphérique USB connecté sera disponible une fois la reconnaissance du système terminée et les exigences du support définies."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dispositivo USB collegato sarà disponibile dopo il completamento del riconoscimento del sistema e la definizione dei requisiti del supporto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "接続されたUSBデバイスは、システム認識が完了し、必要なメディア要件が確定した後に利用可能になります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podłączony nośnik USB zostanie udostępniony po zakończeniu rozpoznawania systemu i określeniu wymagań dotyczących nośnika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O dispositivo USB conectado ficará disponível após a conclusão do reconhecimento do sistema e a definição dos critérios exigidos para a mídia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Подключенное USB-устройство станет доступно после завершения распознавания системы и определения требований к носителю."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bağlı USB aygıtı, sistem tanıma tamamlandıktan ve gerekli medya ölçütleri belirlendikten sonra kullanılabilir olacaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Підключений USB-носій стане доступним після завершення розпізнавання системи та визначення вимог до носія."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Thiết bị USB đã kết nối sẽ khả dụng sau khi quá trình nhận diện hệ thống hoàn tất và các tiêu chí phương tiện cần thiết được xác định."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "连接的 USB 设备将在系统识别完成并确定所需介质条件后可用。"
          }
        }
      }
    },
