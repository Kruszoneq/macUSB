    "creator.raw_image.unmount.alert.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ausgewählte Laufwerk wird von einer anderen App verwendet. Um mit dem Schreiben des Images fortzufahren, kann macUSB das Gerät zwangsweise aushängen. Nicht gespeicherte Daten auf diesem Laufwerk können verloren gehen. Möchten Sie das Aushängen erzwingen?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected drive is being used by another app. To continue writing the image, macUSB can forcibly unmount the device. Unsaved data on this drive may be lost. Do you want to forcibly unmount it?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Otra app está usando la unidad seleccionada. Para continuar escribiendo la imagen, macUSB puede forzar el desmontaje del dispositivo. Los datos no guardados de esta unidad podrían perderse. ¿Quieres forzar el desmontaje?"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lecteur sélectionné est utilisé par une autre app. Pour poursuivre l’écriture de l’image, macUSB peut forcer le démontage de l’appareil. Les données non enregistrées sur ce lecteur peuvent être perdues. Voulez-vous forcer le démontage ?"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’unità selezionata è utilizzata da un’altra app. Per continuare a scrivere l’immagine, macUSB può forzare lo smontaggio del dispositivo. I dati non salvati su questa unità potrebbero andare persi. Vuoi forzare lo smontaggio?"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したドライブは別のアプリで使用されています。イメージの書き込みを続けるため、macUSBはデバイスを強制的にアンマウントできます。このドライブ上の未保存データは失われる可能性があります。強制的にアンマウントしますか？"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrany nośnik jest używany przez inną aplikację. Aby kontynuować zapis obrazu, macUSB może wymusić odmontowanie urządzenia. Niezapisane dane na tym nośniku mogą zostać utracone. Czy chcesz wymusić odmontowanie?"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A unidade selecionada está sendo usada por outro app. Para continuar gravando a imagem, o macUSB pode forçar a desmontagem do dispositivo. Dados não salvos nessa unidade podem ser perdidos. Deseja forçar a desmontagem?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранный накопитель используется другим приложением. Чтобы продолжить запись образа, macUSB может принудительно отключить устройство. Несохраненные данные на этом накопителе могут быть потеряны. Принудительно отключить его?"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen sürücü başka bir uygulama tarafından kullanılıyor. İmajı yazmayı sürdürmek için macUSB aygıtın bağlantısını zorla kesebilir. Bu sürücüdeki kaydedilmemiş veriler kaybolabilir. Bağlantı zorla kesilsin mi?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибраний носій використовується іншою програмою. Щоб продовжити запис образу, macUSB може примусово відмонтувати пристрій. Незбережені дані на цьому носії можуть бути втрачені. Примусово відмонтувати його?"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ổ đã chọn đang được một ứng dụng khác sử dụng. Để tiếp tục ghi ảnh đĩa, macUSB có thể buộc tháo gắn kết thiết bị. Dữ liệu chưa lưu trên ổ này có thể bị mất. Bạn có muốn buộc tháo gắn kết không?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选驱动器正被其他 App 使用。为了继续写入镜像，macUSB 可以强制卸载设备。此驱动器上未保存的数据可能会丢失。要强制卸载吗？"
          }
        }
      }
    },
