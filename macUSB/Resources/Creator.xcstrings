    "creator.macos.rosetta.not_available.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Installation von Rosetta ist abgeschlossen, die Verfügbarkeit kann jedoch noch nicht bestätigt werden. Warte einen Moment und prüfe dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosetta installation finished, but its availability can’t be confirmed yet. Wait a moment, then check again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La instalación de Rosetta ha finalizado, pero aún no se puede confirmar que esté disponible. Espera un momento y vuelve a comprobarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’installation de Rosetta est terminée, mais sa disponibilité ne peut pas encore être confirmée. Patientez un instant, puis vérifiez à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’installazione di Rosetta è terminata, ma non è ancora possibile confermarne la disponibilità. Attendi qualche istante, quindi verifica di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosettaのインストールは完了しましたが、まだ利用可能であることを確認できません。しばらく待ってから、もう一度確認してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instalacja Rosetty zakończyła się, ale nie można jeszcze potwierdzić jej dostępności. Poczekaj chwilę i sprawdź ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A instalação do Rosetta terminou, mas ainda não foi possível confirmar sua disponibilidade. Aguarde um momento e verifique novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Установка Rosetta завершена, но пока не удалось подтвердить ее доступность. Немного подождите и выполните проверку еще раз."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosetta yüklemesi tamamlandı ancak kullanılabilir olduğu henüz doğrulanamıyor. Bir süre bekleyip yeniden denetleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інсталювання Rosetta завершено, але її доступність поки не вдалося підтвердити. Трохи зачекайте та перевірте ще раз."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá trình cài đặt Rosetta đã hoàn tất nhưng chưa thể xác nhận khả năng sử dụng. Hãy đợi một lát rồi kiểm tra lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosetta 安装已完成，但目前仍无法确认它是否可用。请稍候片刻，然后重新检查。"
          }
        }
      }
    },
