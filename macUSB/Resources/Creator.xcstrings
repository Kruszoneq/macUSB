    "creator.macos.rosetta.install_failed.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Überprüfe deine Internetverbindung und versuche es erneut. Details wurden im Diagnoseprotokoll gespeichert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Check your internet connection and try again. Details were saved to the diagnostic log."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba tu conexión a internet e inténtalo de nuevo. Los detalles se han guardado en el registro de diagnóstico."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez votre connexion à Internet et réessayez. Les détails ont été enregistrés dans le journal de diagnostic."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controlla la connessione a Internet e riprova. I dettagli sono stati salvati nel registro di diagnostica."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インターネット接続を確認して、もう一度お試しください。詳細は診断ログに保存されました。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź połączenie z Internetem i spróbuj ponownie. Szczegóły zapisano w logach diagnostycznych."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique sua conexão com a internet e tente novamente. Os detalhes foram salvos no registro de diagnóstico."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Проверьте подключение к интернету и повторите попытку. Подробные сведения сохранены в журнале диагностики."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "İnternet bağlantınızı denetleyip yeniden deneyin. Ayrıntılar tanılama günlüğüne kaydedildi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Перевірте з’єднання з інтернетом і повторіть спробу. Докладні відомості збережено в журналі діагностики."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy kiểm tra kết nối internet rồi thử lại. Chi tiết đã được lưu vào nhật ký chẩn đoán."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请检查互联网连接，然后重试。详细信息已存储到诊断日志中。"
          }
        }
      }
    },
