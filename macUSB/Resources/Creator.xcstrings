    "creator.windows.summary.autounattend.conflict.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ausgewählte Windows-Image enthält eine eigene automatische Konfiguration. Du kannst sie beibehalten, durch die macUSB-Konfiguration ersetzen oder das Erstellen des Mediums abbrechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected Windows image includes its own automatic configuration. You can keep it, replace it with the macUSB configuration, or stop creating the drive."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen de Windows seleccionada incluye su propia configuración automática. Puedes conservarla, sustituirla por la configuración de macUSB o detener la creación del dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image Windows sélectionnée contient sa propre configuration automatique. Vous pouvez la conserver, la remplacer par la configuration macUSB ou arrêter la création du support."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’immagine Windows selezionata include una propria configurazione automatica. Puoi mantenerla, sostituirla con la configurazione di macUSB oppure interrompere la creazione del supporto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したWindowsイメージには独自の自動構成が含まれています。そのまま使用するか、macUSBの構成に置き換えるか、ドライブの作成を停止できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybrany obraz Windows zawiera własną konfigurację automatyczną. Możesz ją zachować, zastąpić konfiguracją macUSB albo przerwać tworzenie nośnika."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A imagem do Windows selecionada inclui sua própria configuração automática. Você pode mantê-la, substituí-la pela configuração do macUSB ou interromper a criação da unidade."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбранный образ Windows содержит собственную автоматическую настройку. Вы можете оставить ее, заменить настройкой macUSB или остановить создание носителя."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen Windows imajı kendi otomatik yapılandırmasını içeriyor. Bunu koruyabilir, macUSB yapılandırmasıyla değiştirebilir veya sürücünün oluşturulmasını durdurabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибраний образ Windows містить власну автоматичну конфігурацію. Ви можете залишити її, замінити конфігурацією macUSB або зупинити створення носія."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh Windows đã chọn có cấu hình tự động riêng. Bạn có thể giữ cấu hình đó, thay bằng cấu hình macUSB hoặc dừng tạo ổ đĩa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选 Windows 映像包含自己的自动配置。你可以保留它、替换为 macUSB 配置，或停止创建驱动器。"
          }
        }
      }
    },
