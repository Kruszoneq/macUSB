    "creator.windows.summary.autounattend.card.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Umgehe ausgewählte Windows-Einschränkungen und vereinfache die Ersteinrichtung des Systems."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bypass selected Windows restrictions and simplify initial system setup."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Omite determinadas restricciones de Windows y simplifica la configuración inicial del sistema."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contournez certaines restrictions de Windows et simplifiez la configuration initiale du système."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aggira alcune restrizioni di Windows e semplifica la configurazione iniziale del sistema."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したWindowsの制限を回避し、システムの初期設定を簡単にします。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pomiń wybrane restrykcje Windows i uprość pierwszą konfigurację systemu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Contorne algumas restrições do Windows e simplifique a configuração inicial do sistema."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обойдите выбранные ограничения Windows и упростите начальную настройку системы."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen Windows kısıtlamalarını atlayın ve sistemin ilk kurulumunu kolaylaştırın."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обійдіть вибрані обмеження Windows і спростіть початкове налаштування системи."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bỏ qua các hạn chế Windows đã chọn và đơn giản hóa thiết lập ban đầu của hệ thống."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "绕过所选 Windows 限制，并简化系统的初始设置。"
          }
        }
      }
    },
