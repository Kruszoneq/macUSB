    "creator.windows.summary.wimlib.required.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Windows-Image erfordert die Aufteilung der Datei install.wim. Um mit der Erstellung des USB-Mediums zu beginnen, installieren Sie wimlib und prüfen Sie dann erneut"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Windows image requires splitting the install.wim file. To start creating the USB installer, install wimlib and then check again"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta imagen de Windows requiere dividir el archivo install.wim. Para iniciar la creación del instalador USB, instala wimlib y vuelve a comprobarlo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette image Windows nécessite la division du fichier install.wim. Pour commencer la création du support USB, installez wimlib puis vérifiez à nouveau"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa immagine di Windows richiede la suddivisione del file install.wim. Per avviare la creazione del supporto USB, installa wimlib e verifica di nuovo"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この Windows イメージでは install.wim ファイルの分割が必要です。USB インストーラの作成を開始するには wimlib をインストールしてから再確認してください"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten obraz Windows wymaga podziału pliku install.wim. Aby rozpocząć tworzenie nośnika USB, zainstaluj wimlib, a następnie sprawdź ponownie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta imagem do Windows exige a divisão do arquivo install.wim. Para iniciar a criação da mídia USB, instale o wimlib e verifique novamente"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот образ Windows требует разделения файла install.wim. Чтобы начать создание USB-носителя, установите wimlib и проверьте снова"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu Windows imajı install.wim dosyasının bölünmesini gerektirir. USB yükleyici oluşturmayı başlatmak için wimlib kurun ve yeniden denetleyin"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей образ Windows потребує поділу файлу install.wim. Щоб почати створення USB-носія, встановіть wimlib і перевірте ще раз"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh Windows này yêu cầu tách tệp install.wim. Để bắt đầu tạo bộ cài USB, hãy cài đặt wimlib rồi kiểm tra lại"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 Windows 镜像需要拆分 install.wim 文件。要开始创建 USB 安装介质，请安装 wimlib 后重新检查"
          }
        }
      }
    },
