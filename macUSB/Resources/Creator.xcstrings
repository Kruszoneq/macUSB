    "creator.macos.error.install_esd_missing" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InstallESD.dmg-Datei nicht gefunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "InstallESD.dmg file not found."
          }
        },
