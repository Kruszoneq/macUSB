    "creator.raw_image.summary.unreadable.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Während des Schreibvorgangs meldet macOS möglicherweise, dass das Laufwerk nicht lesbar ist. Dies ist zu erwarten. Wählen Sie „Ignorieren“, um fortzufahren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "During the write, macOS may report that the drive is unreadable. This is expected. To continue, choose “Ignore”."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la escritura, macOS puede indicar que la unidad no se puede leer. Este comportamiento es normal. Para continuar, selecciona «Ignorar»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pendant l’écriture, macOS peut signaler que le lecteur est illisible. Ce comportement est normal. Pour continuer, choisissez « Ignorer »."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante la scrittura, macOS potrebbe segnalare che l’unità non è leggibile. È un comportamento previsto. Per continuare, scegli “Ignora”."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "書き込み中に、ドライブを読み取れないというメッセージがmacOSに表示される場合があります。これは想定される動作です。続けるには「無視」を選択してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Podczas zapisu macOS może poinformować, że nośnik jest nieczytelny. Jest to oczekiwane zachowanie. Aby kontynuować, wybierz „Ignoruj”."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Durante a gravação, o macOS pode informar que a unidade não pode ser lida. Esse comportamento é esperado. Para continuar, escolha “Ignorar”."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Во время записи macOS может сообщить, что накопитель не читается. Это ожидаемое поведение. Чтобы продолжить, выберите «Игнорировать»."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yazma sırasında macOS sürücünün okunamadığını bildirebilir. Bu beklenen bir durumdur. Sürdürmek için “Yoksay”ı seçin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Під час запису macOS може повідомити, що носій не читається. Це очікувана поведінка. Щоб продовжити, виберіть «Ігнорувати»."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trong khi ghi, macOS có thể báo rằng ổ đĩa không đọc được. Đây là hành vi dự kiến. Để tiếp tục, hãy chọn “Bỏ qua”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "写入期间，macOS 可能会报告驱动器无法读取。这是预期行为。要继续，请选择“忽略”。"
          }
        }
      }
    },
