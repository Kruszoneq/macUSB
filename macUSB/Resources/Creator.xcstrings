            "value" : "Không thể tự động làm mới trình trợ giúp. Mở Công cụ → Trình trợ giúp sửa chữa và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无法自动刷新 helper。请打开 工具 → 修复 helper 后重试。"
          }
        }
      }
    },
