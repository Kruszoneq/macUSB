    "app.permissions.full_disk_access.settings_fallback.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Bereich „Vollständiger Festplattenzugriff“ konnte nicht direkt geöffnet werden. Gehen Sie zu: Datenschutz & Sicherheit -> Vollständiger Festplattenzugriff."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Could not open the “Full Disk Access” section directly. Go to: Privacy & Security -> Full Disk Access."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se pudo abrir directamente la sección «Acceso total al disco». Ve a: Privacidad y seguridad -> Acceso total al disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossible d’ouvrir directement la section « Accès complet au disque ». Allez dans : Confidentialité et sécurité -> Accès complet au disque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Non è stato possibile aprire direttamente la sezione «Accesso completo al disco». Vai a: Privacy e sicurezza -> Accesso completo al disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「フルディスクアクセス」を直接開けませんでした。次へ移動してください: プライバシーとセキュリティ -> フルディスクアクセス。"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het onderdeel “Volledige schijftoegang” kon niet rechtstreeks worden geopend. Ga naar: Privacy en beveiliging -> Volledige schijftoegang."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się otworzyć bezpośrednio zakładki „Pełny dostęp do dysku”. Przejdź do: Prywatność i ochrona -> Pełny dostęp do dysku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não foi possível abrir diretamente a seção “Acesso total ao disco”. Vá para: Privacidade e Segurança -> Acesso total ao disco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось напрямую открыть раздел «Полный доступ к диску». Перейдите: Конфиденциальность и безопасность -> Полный доступ к диску."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Tam Disk Erişimi” bölümü doğrudan açılamadı. Şuraya gidin: Gizlilik ve Güvenlik -> Tam Disk Erişimi."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не вдалося напряму відкрити розділ «Повний доступ до диска». Перейдіть: Приватність і безпека -> Повний доступ до диска."
          }
        },
