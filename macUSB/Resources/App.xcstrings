        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pozwoli to na otrzymanie informacji o zakończeniu procesu przygotowania nośnika instalacyjnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
