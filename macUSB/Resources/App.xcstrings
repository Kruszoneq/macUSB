          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Điều này sẽ cho phép bạn nhận được thông tin về việc hoàn tất quá trình chuẩn bị phương tiện cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
