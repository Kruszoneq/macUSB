    "summary.macos.rosetta.not_available.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Installation von Rosetta ist abgeschlossen, die Verfügbarkeit kann jedoch noch nicht bestätigt werden. Warte einen Moment und prüfe dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosetta installation finished, but its availability can’t be confirmed yet. Wait a moment, then check again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La instalación de Rosetta ha finalizado, pero aún no se puede confirmar que esté disponible. Espera un momento y vuelve a comprobarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’installation de Rosetta est terminée, mais sa disponibilité ne peut pas encore être confirmée. Patientez un instant, puis vérifiez à nouveau."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’installazione di Rosetta è terminata, ma non è ancora possibile confermarne la disponibilità. Attendi qualche istante, quindi verifica di nuovo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rosettaのインストールは完了しましたが、まだ利用可能であることを確認できません。しばらく待ってから、もう一度確認してください。"
