    "summary.macos.rosetta.missing.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Tool createinstallmedia im ausgewählten Installationsprogramm wurde für Intel Prozessoren entwickelt und benötigt Rosetta auf diesem Mac. Installiere Rosetta, um mit dem Erstellen des Installationsmediums zu beginnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The createinstallmedia tool in the selected installer is built for Intel processors and requires Rosetta on this Mac. Install Rosetta to start creating the installation media."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La herramienta createinstallmedia del instalador seleccionado se ha creado para procesadores Intel y necesita Rosetta en este Mac. Instala Rosetta para empezar a crear el soporte de instalación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’outil createinstallmedia du programme d’installation sélectionné est conçu pour les processeurs Intel et nécessite Rosetta sur ce Mac. Installez Rosetta pour commencer à créer le support d’installation."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lo strumento createinstallmedia nel programma di installazione selezionato è progettato per processori Intel e richiede Rosetta su questo Mac. Installa Rosetta per iniziare a creare il supporto di installazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選択したインストーラのcreateinstallmediaツールはIntelプロセッサ向けで、このMacではRosettaが必要です。インストールメディアの作成を開始するには、Rosettaをインストールしてください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Narzędzie createinstallmedia w wybranym instalatorze jest przeznaczone dla procesorów Intel i wymaga Rosetty na tym Macu. Zainstaluj Rosettę, aby rozpocząć tworzenie nośnika instalacyjnego."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A ferramenta createinstallmedia do instalador selecionado foi desenvolvida para processadores Intel e requer o Rosetta neste Mac. Instale o Rosetta para começar a criar a mídia de instalação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инструмент createinstallmedia в выбранном установщике создан для процессоров Intel, поэтому на этом компьютере Mac требуется Rosetta. Установите Rosetta, чтобы начать создание установочного носителя."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seçilen yükleyicideki createinstallmedia aracı Intel işlemciler için geliştirilmiştir ve bu Mac’te Rosetta gerektirir. Yükleme ortamını oluşturmaya başlamak için Rosetta’yı yükleyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Засіб createinstallmedia у вибраному інсталяторі створено для процесорів Intel, тому на цьому комп’ютері Mac потрібна Rosetta. Інсталюйте Rosetta, щоб розпочати створення інсталяційного носія."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Công cụ createinstallmedia trong trình cài đặt đã chọn được tạo cho bộ xử lý Intel và yêu cầu Rosetta trên máy Mac này. Hãy cài đặt Rosetta để bắt đầu tạo phương tiện cài đặt."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所选安装器中的 createinstallmedia 工具专为 Intel 处理器构建，需要在这台 Mac 上使用 Rosetta。请安装 Rosetta 以开始创建安装介质。"
          }
        }
      }
    },
