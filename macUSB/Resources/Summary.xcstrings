    "summary.windows.bios_only.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses USB-Medium wird ausschließlich für den Start im Legacy-BIOS-Modus vorbereitet. Der UEFI-Start wird nicht unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This USB media will be prepared for Legacy BIOS boot only. UEFI boot is not supported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este medio USB se preparará solo para arrancar en modo BIOS heredado. El arranque UEFI no es compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce support USB sera préparé uniquement pour un démarrage en mode BIOS hérité. Le démarrage UEFI n’est pas pris en charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo supporto USB verrà preparato esclusivamente per l’avvio in modalità BIOS legacy. L’avvio UEFI non è supportato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このUSBメディアはLegacy BIOS起動専用として準備されます。UEFI起動には対応していません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten nośnik USB zostanie przygotowany wyłącznie do uruchamiania w trybie Legacy BIOS. Uruchamianie w trybie UEFI nie jest obsługiwane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta mídia USB será preparada apenas para inicialização no modo BIOS legado. A inicialização UEFI não é compatível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот USB-носитель будет подготовлен только для загрузки в режиме Legacy BIOS. Загрузка в режиме UEFI не поддерживается."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu USB ortamı yalnızca Legacy BIOS modunda önyükleme için hazırlanacaktır. UEFI önyükleme desteklenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей USB-носій буде підготовлено лише для завантаження в режимі Legacy BIOS. Завантаження в режимі UEFI не підтримується."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phương tiện USB này sẽ chỉ được chuẩn bị để khởi động ở chế độ Legacy BIOS. Khởi động UEFI không được hỗ trợ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 USB 介质将仅用于 Legacy BIOS 模式启动。不支持 UEFI 启动。"
          }
        }
      }
    },
