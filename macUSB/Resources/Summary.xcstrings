    "summary.windows.uefi_only.body" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses USB-Medium wird ausschließlich für den UEFI-Start vorbereitet. Der Start im Legacy-BIOS-Modus wird nicht unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This USB media will be prepared for UEFI boot only. Legacy BIOS boot is not supported."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este medio USB se preparará solo para arranque UEFI. El arranque en modo BIOS heredado no es compatible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce support USB sera préparé uniquement pour un démarrage UEFI. Le démarrage en mode BIOS hérité n’est pas pris en charge."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questo supporto USB sarà preparato solo per l’avvio UEFI. L’avvio in modalità BIOS legacy non è supportato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このUSBメディアはUEFI起動専用として準備されます。Legacy BIOSでの起動には対応していません。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten nośnik USB zostanie przygotowany wyłącznie do uruchamiania w trybie UEFI. Uruchamianie w trybie Legacy BIOS nie jest obsługiwane."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta mídia USB será preparada apenas para inicialização UEFI. A inicialização no modo BIOS legado não é compatível."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Этот USB-носитель будет подготовлен только для загрузки в режиме UEFI. Загрузка в режиме Legacy BIOS не поддерживается."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bu USB ortamı yalnızca UEFI önyükleme için hazırlanacaktır. Legacy BIOS modunda önyükleme desteklenmez."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Цей USB-носій буде підготовлено лише для завантаження в режимі UEFI. Завантаження в режимі Legacy BIOS не підтримується."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Phương tiện USB này sẽ chỉ được chuẩn bị cho khởi động UEFI. Không hỗ trợ khởi động ở chế độ Legacy BIOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此 USB 介质将仅用于 UEFI 启动。不支持 Legacy BIOS 模式启动。"
          }
        }
      }
    },
