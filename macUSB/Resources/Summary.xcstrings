    "summary.raw_image.usb_legacy.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das ausgewählte Laufwerk verwendet einen älteren Datenübertragungsstandard. Der Schreibvorgang kann mehrere Minuten dauern"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The selected drive uses an older data transfer standard. The write may take several minutes"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La unidad seleccionada utiliza un estándar de transferencia de datos antiguo. La escritura puede tardar varios minutos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le lecteur sélectionné utilise une ancienne norme de transfert de données. L’écriture peut prendre plusieurs minutes"
          }
        },
        "it" : {
