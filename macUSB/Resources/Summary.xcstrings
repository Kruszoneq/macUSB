    "summary.macos.rosetta.license.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn du „Akzeptieren“ auswählst, stimmst du den Bedingungen des Apple Softwarelizenzvertrags für Rosetta zu. Anschließend wird Rosetta auf diesem Mac installiert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "By choosing “Agree,” you agree to the terms of Apple’s software license agreement for Rosetta. Rosetta will then be installed on this Mac."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al elegir «Aceptar», aceptas los términos del contrato de licencia de software de Apple para Rosetta. A continuación, Rosetta se instalará en este Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En choisissant « Accepter », vous acceptez les conditions du contrat de licence de logiciel Apple relatif à Rosetta. Rosetta sera ensuite installée sur ce Mac."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Scegliendo “Accetto”, accetti i termini del contratto di licenza software Apple per Rosetta. Rosetta verrà quindi installato su questo Mac."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「同意する」を選択すると、Rosettaに関するAppleソフトウェア使用許諾契約の条件に同意したことになります。同意すると、このMacにRosettaがインストールされます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybranie opcji „Akceptuję” oznacza akceptację warunków umowy licencyjnej oprogramowania Apple dotyczącej Rosetty. Po zaakceptowaniu Rosetta zostanie zainstalowana na tym Macu."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao escolher “Concordo”, você concorda com os termos do contrato de licença de software da Apple referente ao Rosetta. Em seguida, o Rosetta será instalado neste Mac."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выбирая «Принимаю», вы принимаете условия лицензионного соглашения Apple на программное обеспечение Rosetta. После этого Rosetta будет установлена на этом компьютере Mac."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Kabul Ediyorum”u seçerek Apple’ın Rosetta yazılım lisans sözleşmesinin koşullarını kabul etmiş olursunuz. Ardından Rosetta bu Mac’e yüklenir."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вибираючи «Приймаю», ви приймаєте умови ліцензійної угоди Apple щодо програмного забезпечення Rosetta. Після цього Rosetta буде інстальовано на цьому комп’ютері Mac."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi chọn “Đồng ý”, bạn đồng ý với các điều khoản trong thỏa thuận cấp phép phần mềm của Apple dành cho Rosetta. Sau đó, Rosetta sẽ được cài đặt trên máy Mac này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择“同意”即表示您同意 Apple 有关 Rosetta 的软件许可协议条款。随后，Rosetta 将安装在这台 Mac 上。"
          }
        }
      }
    },
