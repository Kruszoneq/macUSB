    "downloader.network.warning.reconnect_countdown" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Download wurde angehalten. Der Vorgang wird automatisch fortgesetzt, sobald die Verbindung wiederhergestellt ist (%@ verbleibende Sekunden)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download has been paused. It will resume automatically after the connection is restored (remaining: %@ s)."
          }
