    "downloader.disk_image.folder_unavailable.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vergewissere dich, dass der Ordner noch vorhanden ist und du die Berechtigung hast, Dateien darin zu sichern. Versuche es dann erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Make sure the folder still exists and that you have permission to save files there, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Comprueba que la carpeta todavía exista y que tengas permiso para guardar archivos en ella. Después, inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vérifiez que le dossier existe toujours et que vous êtes autorisé à y enregistrer des fichiers, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Assicurati che la cartella esista ancora e di disporre dell’autorizzazione per salvarvi i file, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォルダが存在し、ファイルを保存する権限があることを確認してから、もう一度お試しください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sprawdź, czy katalog nadal istnieje i czy masz uprawnienia do zapisywania w nim plików, a następnie spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verifique se a pasta ainda existe e se você tem permissão para salvar arquivos nela. Depois, tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Убедитесь, что папка существует и у вас есть разрешение сохранять в ней файлы, затем повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Klasörün hâlâ var olduğundan ve klasöre dosya kaydetme izniniz bulunduğundan emin olup yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переконайтеся, що папка досі існує та ви маєте дозвіл зберігати в ній файли, а потім повторіть спробу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hãy đảm bảo thư mục vẫn tồn tại và bạn có quyền lưu tệp vào đó, sau đó thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请确保该文件夹仍然存在，并且您有权在其中存储文件，然后再试一次。"
          }
        }
      }
    },
