    "downloader.cancellation.alert.debug_message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn Sie das Fenster schließen, wird der Download gestoppt und die temporären Dateien bleiben erhalten, bis Sie die Anwendung schließen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "When you close the window, the download will stop and the temporary files will remain until you close the application"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Al cerrar la ventana, la descarga se detendrá y los archivos temporales permanecerán hasta que cierres la aplicación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lorsque vous fermez la fenêtre, le téléchargement s'arrêtera et les fichiers temporaires resteront jusqu'à ce que vous fermiez l'application"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quando chiudi la finestra, il download si interromperà e i file temporanei rimarranno finché non chiuderai l'applicazione"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ウィンドウを閉じるとダウンロードは停止し、アプリケーションを閉じるまで一時ファイルが残ります。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Po zamknięciu okna pobieranie zostanie przerwane, a pliki tymczasowe pozostaną do czasu zamknięcia aplikacji"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ao fechar a janela, o download será interrompido e os arquivos temporários permanecerão até você fechar o aplicativo"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Когда вы закроете окно, загрузка прекратится, а временные файлы останутся до тех пор, пока вы не закроете приложение."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pencereyi kapattığınızda indirme işlemi duracak ve geçici dosyalar siz uygulamayı kapatana kadar kalacaktır."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Коли ви закриєте вікно, завантаження припиниться, а тимчасові файли залишаться, доки ви не закриєте програму"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Khi bạn đóng cửa sổ, quá trình tải xuống sẽ dừng lại và các tệp tạm thời sẽ vẫn còn cho đến khi bạn đóng ứng dụng"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当您关闭窗口时，下载将停止，临时文件将保留，直到您关闭应用程序"
          }
        }
      }
    },
