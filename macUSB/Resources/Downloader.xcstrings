        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The system volume does not have enough free space to download and prepare the installer and create the disk image.\n\nRequired space: %@ GB\nAvailable space: %@ GB"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El volumen del sistema no tiene suficiente espacio libre para descargar y preparar el instalador y crear la imagen de disco.\n\nEspacio necesario: %@ GB\nEspacio disponible: %@ GB"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le volume système ne dispose pas de suffisamment d’espace libre pour télécharger et préparer le programme d’installation, puis créer l’image disque.\n\nEspace requis : %@ GB\nEspace disponible : %@ GB"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il volume di sistema non dispone di spazio libero sufficiente per scaricare e preparare il programma di installazione e creare l’immagine disco.\n\nSpazio richiesto: %@ GB\nSpazio disponibile: %@ GB"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "システムボリュームに、インストーラのダウンロードと準備、およびディスクイメージの作成に必要な空き領域がありません。\n\n必要な空き容量：%@ GB\n使用可能な空き容量：%@ GB"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Na woluminie systemowym nie ma wystarczającej ilości wolnego miejsca, aby pobrać i przygotować instalator oraz utworzyć obraz dysku.\n\nWymagane miejsce: %@ GB\nDostępne miejsce: %@ GB"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O volume do sistema não tem espaço livre suficiente para baixar e preparar o instalador e criar a imagem de disco.\n\nEspaço necessário: %@ GB\nEspaço disponível: %@ GB"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На системном томе недостаточно свободного места для загрузки и подготовки установщика, а также создания образа диска.\n\nТребуется: %@ GB\nДоступно: %@ GB"
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sistem disk bölümünde yükleyiciyi indirip hazırlamak ve disk görüntüsünü oluşturmak için yeterli boş alan yok.\n\nGerekli alan: %@ GB\nKullanılabilir alan: %@ GB"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "На системному томі недостатньо вільного місця для завантаження й підготовки інсталятора та створення образу диска.\n\nПотрібно: %@ GB\nДоступно: %@ GB"
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ổ đĩa hệ thống không có đủ dung lượng trống để tải về và chuẩn bị trình cài đặt cũng như tạo ảnh đĩa.\n\nDung lượng cần: %@ GB\nDung lượng khả dụng: %@ GB"
