          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Quá trình tải xuống đã bị tạm dừng. Nó sẽ tự động tiếp tục sau khi kết nối được khôi phục (còn %@ giây)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载已暂停。连接恢复后（剩余 %@ 秒），它将自动恢复。"
          }
        }
