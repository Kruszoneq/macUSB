    "downloader.disk_image.partial.source_removal" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Disk-Image wurde erstellt, aber das ursprüngliche Installationsprogramm „%@“ konnte nicht entfernt werden. Beide Dateien verbleiben auf dem Volume."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The disk image was created, but the source installer “%@” could not be removed. Both files remain on disk."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La imagen de disco se ha creado, pero no se ha podido eliminar el instalador de origen «%@». Ambos archivos permanecen en el disco."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’image disque a été créée, mais le programme d’installation source « %@ » n’a pas pu être supprimé. Les deux fichiers restent sur le disque."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’immagine disco è stata creata, ma non è stato possibile rimuovere il programma di installazione di origine “%@”. Entrambi i file rimangono sul disco."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ディスクイメージは作成されましたが、元のインストーラ「%@」を削除できませんでした。両方のファイルがディスクに残っています。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Obraz dysku został utworzony, ale nie udało się usunąć źródłowego instalatora „%@”. Oba pliki pozostały na dysku."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A imagem de disco foi criada, mas não foi possível remover o instalador de origem “%@”. Os dois arquivos permanecem no disco."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Образ диска создан, но не удалось удалить исходный установщик «%@». Оба файла остались на диске."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Disk görüntüsü oluşturuldu ancak kaynak yükleyici “%@” kaldırılamadı. Her iki dosya da diskte kaldı."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
