    "downloader.assembly.error.destination_access" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Installationsprogramm konnte nicht am Zielspeicherort gespeichert werden. Bitte überprüfen Sie Ihre Berechtigungen und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The installer could not be saved to the target location. Please check your permissions and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El instalador no se pudo guardar en la ubicación de destino. Por favor verifique sus permisos e inténtelo nuevamente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le programme d'installation n'a pas pu être enregistré à l'emplacement cible. Veuillez vérifier vos autorisations et réessayer."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impossibile salvare l'installer nella posizione di destinazione. Controlla le tue autorizzazioni e riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "インストーラーをターゲットの場所に保存できませんでした。権限を確認して再試行してください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nie udało się zapisać instalatora w lokalizacji docelowej. Sprawdź uprawnienia i spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O instalador não pôde ser salvo no local de destino. Verifique suas permissões e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Не удалось сохранить программу установки в целевом месте. Пожалуйста, проверьте свои разрешения и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Yükleyici hedef konuma kaydedilemedi. Please check your permissions and try again."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Інсталятор не вдалося зберегти в цільовому місці. Перевірте свої дозволи та повторіть спробу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Không thể lưu trình cài đặt vào vị trí đích. Vui lòng kiểm tra quyền của bạn và thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安装程序无法保存到目标位置。请检查您的权限并重试。"
          }
        }
      }
    },
