    "downloader.disk_image.space.system.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Systemvolume ist nicht genügend freier Speicherplatz verfügbar, um das Installationsprogramm zu laden und vorzubereiten sowie das Disk-Image zu erstellen.\n\nErforderlicher Speicherplatz: %@ GB\nVerfügbarer Speicherplatz: %@ GB"
