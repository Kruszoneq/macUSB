          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ảnh đĩa đã được tạo nhưng không thể xóa trình cài đặt nguồn “%@”. Cả hai tệp vẫn còn trên đĩa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "磁盘映像已创建，但无法移除源安装器“%@”。这两个文件都保留在磁盘上。"
