    "downloader.prerequisites.full_disk_and_helper_unavailable.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um ein macOS-Installationsprogramm zu laden und vorzubereiten, erteile macUSB in den Systemeinstellungen Festplattenvollzugriff. Das macUSB-Hilfsprogramm ist ebenfalls nicht verfügbar. Wähle „Werkzeuge“ → „Helper reparieren“ und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To download and prepare a macOS installer, grant macUSB Full Disk Access in System Settings. The macUSB helper tool is also unavailable. Choose Tools → Repair Helper, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para descargar y preparar un instalador de macOS, concede a macUSB acceso total al disco en Ajustes del Sistema. La herramienta auxiliar de macUSB tampoco está disponible. Selecciona Herramientas → Reparar helper e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour télécharger et préparer un programme d’installation de macOS, accordez à macUSB l’accès complet au disque dans Réglages Système. L’outil auxiliaire de macUSB est également indisponible. Choisissez Outils → Réparer l’outil auxiliaire, puis réessayez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Per scaricare e preparare un programma di installazione di macOS, concedi a macUSB l’accesso completo al disco in Impostazioni di Sistema. Anche l’helper di macUSB non è disponibile. Scegli Strumenti → Ripara helper, quindi riprova."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOSインストーラをダウンロードして準備するには、「システム設定」でmacUSBにフルディスクアクセスを許可してください。macUSBのヘルパーも利用できません。「ツール」＞「ヘルパーを修復」と選択してから、もう一度お試しください。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aby pobrać i przygotować instalator macOS, przyznaj aplikacji macUSB uprawnienie „Pełny dostęp do dysku” w Ustawieniach systemowych. Narzędzie pomocnicze macUSB również nie jest dostępne. Wybierz Narzędzia → Napraw helpera, a następnie spróbuj ponownie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para baixar e preparar um instalador do macOS, conceda ao macUSB Acesso Total ao Disco nos Ajustes do Sistema. A ferramenta auxiliar do macUSB também não está disponível. Selecione Ferramentas → Reparar helper e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чтобы загрузить и подготовить установщик macOS, предоставьте macUSB полный доступ к диску в Системных настройках. Вспомогательный инструмент macUSB также недоступен. Выберите «Инструменты» → «Восстановить helper» и повторите попытку."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bir macOS yükleyicisini indirmek ve hazırlamak için Sistem Ayarları’nda macUSB’ye Tam Disk Erişimi verin. macUSB yardımcı aracı da kullanılamıyor. Araçlar → Yardımcıyı düzelt’i seçip yeniden deneyin."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Щоб завантажити й підготувати інсталятор macOS, надайте macUSB повний доступ до диска в Системних параметрах. Допоміжний інструмент macUSB також недоступний. Виберіть Інструменти → Виправити помічника, а потім повторіть спробу."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Để tải về và chuẩn bị trình cài đặt macOS, hãy cấp Quyền truy cập toàn bộ ổ đĩa cho macUSB trong Cài đặt hệ thống. Công cụ trợ giúp macUSB cũng không khả dụng. Chọn Công cụ → Sửa chữa trình trợ giúp, sau đó thử lại."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要下载并准备 macOS 安装器，请在“系统设置”中授予 macUSB“完全磁盘访问权限”。macUSB 辅助工具也不可用。请选择“工具”→“修复辅助工具”，然后再试一次。"
          }
        }
      }
    },
