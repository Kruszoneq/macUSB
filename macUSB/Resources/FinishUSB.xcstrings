    "finish.eject.spotlight.warning.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlight indiziert diesen Datenträger, deshalb kann macOS ihn nicht sicher auswerfen. Sie können das Auswerfen erzwingen, um diesen Vorgang zu beenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlight is indexing this drive, so macOS can’t eject it safely. You can force eject the drive to stop this process."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlight está indexando esta unidad, por lo que macOS no puede expulsarla de forma segura. Puedes forzar la expulsión para interrumpir este proceso."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlight indexe ce disque, macOS ne peut donc pas l’éjecter en toute sécurité. Vous pouvez forcer l’éjection pour interrompre ce processus."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlight sta indicizzando questa unità, quindi macOS non può espellerla in modo sicuro. Puoi forzare l’espulsione per interrompere questo processo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlightがこのドライブの索引を作成中のため、macOSはドライブを安全に取り出せません。強制的に取り出すと、この処理を中断できます。"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlight indeksuje ten nośnik, dlatego macOS nie może go bezpiecznie wysunąć. Możesz wymusić wysunięcie, aby przerwać ten proces."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Spotlight está indexando este dispositivo, por isso o macOS não pode ejetá-lo com segurança. Você pode forçar a ejeção para interromper esse processo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlight индексирует этот накопитель, поэтому macOS не может безопасно извлечь его. Можно выполнить принудительное извлечение, чтобы прервать этот процесс."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlight bu sürücüyü dizinliyor, bu nedenle macOS sürücüyü güvenli bir şekilde çıkaramıyor. Bu işlemi durdurmak için sürücüyü zorla çıkarabilirsiniz."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlight індексує цей накопичувач, тому macOS не може безпечно його вийняти. Можна примусово вийняти накопичувач, щоб перервати цей процес."
          }
        },
        "vi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Spotlight đang lập chỉ mục ổ đĩa này nên macOS không thể tháo ổ đĩa một cách an toàn. Bạn có thể buộc tháo ổ đĩa để dừng quá trình này."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“聚焦”正在索引此驱动器，因此 macOS 无法安全推出它。你可以强制推出驱动器以中断此过程。"
          }
        }
      }
    },
