    "finish.eject.force.error.description" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS kann den Datenträger weiterhin nicht auswerfen. Schließen Sie Apps, die ihn möglicherweise verwenden, und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS still can’t eject the drive. Close any apps that may be using it, then try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS sigue sin poder expulsar la unidad. Cierra las apps que puedan estar usándola e inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
