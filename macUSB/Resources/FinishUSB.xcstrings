          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O macOS ainda não consegue ejetar o dispositivo. Feche os apps que possam estar usando-o e tente novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "macOS по-прежнему не может извлечь накопитель. Закройте приложения, которые могут его использовать, и повторите попытку."
